# Copy to .env.local and fill in. Never commit real secrets.

# Resend API key (https://resend.com/api-keys). Server only: no NEXT_PUBLIC_ prefix.
RESEND_API_KEY=XXXXXXX

# Sender address. Without a verified domain Resend only allows onboarding@resend.dev,
# and that address only delivers to the email of the Resend account owner.
# Sign up in Resend with jmedinalba@gmail.com so contact messages arrive.
CONTACT_FROM_EMAIL=onboarding@resend.dev


SUPABASE_DB_PASSWORD=XXXX

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service_role key (Settings > API keys). Server only: no NEXT_PUBLIC_ prefix.
# Omite RLS. Nunca la expongas al cliente ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública del sitio (sin barra final). Obligatoria en producción: se usa para los enlaces
# de confirmación, OAuth y recuperación. En desarrollo se deriva de la petición si falta.
SITE_URL=

# Sal para el hash de IP que limita la creación de sesiones de juego. Secreto de servidor.
# Genera una con: openssl rand -hex 32
IP_HASH_SALT=
